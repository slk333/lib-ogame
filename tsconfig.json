{
    "include": ["src"],
    "compilerOptions": {
        // input and output hierarchy
        "rootDir": "./src",
        "outDir": "./dist",
        // language and environment
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        // "strict": true // true by default as of TypeScript 6.0
        // linting
        "forceConsistentCasingInFileNames": true,
        // others
        "declaration": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        // maps
        "declarationMap": true,
        "sourceMap": true
    }
}
